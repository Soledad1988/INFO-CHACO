  <diagram id="eshVS0MMjV5wkEWd38fu" name="Ejemplo 3">
    <mxGraphModel dx="1903" dy="716" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="yK1eBmwLQ_JEa305csSG-1" value="Una biblioteca universitaria desea organizar la información sobre los &lt;strong data-start=&quot;358&quot; data-end=&quot;368&quot;&gt;libros&lt;/strong&gt;, los &lt;strong data-start=&quot;374&quot; data-end=&quot;385&quot;&gt;autores&lt;/strong&gt;, los &lt;strong data-start=&quot;391&quot; data-end=&quot;401&quot;&gt;socios&lt;/strong&gt; que realizan préstamos y los &lt;strong data-start=&quot;431&quot; data-end=&quot;444&quot;&gt;empleados&lt;/strong&gt; encargados de gestionarlos.&lt;br data-start=&quot;472&quot; data-end=&quot;475&quot;&gt;&lt;br&gt;Cada &lt;strong data-start=&quot;480&quot; data-end=&quot;489&quot;&gt;libro&lt;/strong&gt; tiene un código único, título, año de publicación, editorial y cantidad de ejemplares disponibles.&lt;br data-start=&quot;588&quot; data-end=&quot;591&quot; data-is-only-node=&quot;&quot;&gt;&lt;br&gt;Un libro puede tener &lt;strong data-start=&quot;612&quot; data-end=&quot;636&quot;&gt;uno o varios autores&lt;/strong&gt;, y de cada autor se registran nombre completo y nacionalidad.&lt;br data-start=&quot;709&quot; data-end=&quot;712&quot;&gt;&lt;br&gt;Los &lt;strong data-start=&quot;716&quot; data-end=&quot;726&quot;&gt;socios&lt;/strong&gt; poseen un número de socio, nombre, dirección y correo electrónico.&lt;br data-start=&quot;793&quot; data-end=&quot;796&quot;&gt;&lt;br&gt;Cada socio puede realizar varios &lt;strong data-start=&quot;829&quot; data-end=&quot;842&quot;&gt;préstamos&lt;/strong&gt;, pero cada préstamo corresponde a un solo socio.&lt;br data-start=&quot;891&quot; data-end=&quot;894&quot;&gt;&lt;br&gt;De cada préstamo se guarda un número de préstamo, la fecha de inicio, la fecha de devolución y el código del libro solicitado.&lt;br data-start=&quot;1020&quot; data-end=&quot;1023&quot;&gt;&lt;br&gt;Cada préstamo es gestionado por un &lt;strong data-start=&quot;1058&quot; data-end=&quot;1070&quot;&gt;empleado&lt;/strong&gt; de la biblioteca, de quien se guarda su legajo, nombre, apellido y cargo.&lt;br data-start=&quot;1144&quot; data-end=&quot;1147&quot;&gt;&lt;br&gt;Un empleado puede registrar varios préstamos, pero cada préstamo es atendido por un solo empleado." style="text;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="30" width="560" height="330" as="geometry" />
        </mxCell>
        <mxCell id="yK1eBmwLQ_JEa305csSG-18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;endFill=0;" edge="1" parent="1" source="yK1eBmwLQ_JEa305csSG-2" target="yK1eBmwLQ_JEa305csSG-15">
